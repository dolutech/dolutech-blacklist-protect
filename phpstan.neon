parameters:
    level: 5
    paths:
        - includes
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - tests/phpstan-constants.php
    ignoreErrors:
        # ABSPATH em ambiente de análise aponta para /tmp (resolvido em runtime pelo WP).
        - '#Path in require_once\(\) "/tmp/wp-admin/includes/upgrade.php"#'
        # Checagem defensiva de $username (array_filter já remove vazios).
        - '#Variable \$username in empty\(\) always exists and is not falsy#'
