{
    "name": "dolutech/dolutech-blacklist-protect",
    "description": "Dev dependencies for Dolutech Blacklist Protect WordPress plugin validation",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpstan/phpstan": "^2.2",
        "php-stubs/wordpress-stubs": "^7.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=WordPress --extensions=php --ignore=*/vendor/*,*/tests/* .",
        "phpstan": "phpstan analyse includes --level=5 --no-progress",
        "check": ["@phpcs", "@phpstan", "@test"]
    }
}
